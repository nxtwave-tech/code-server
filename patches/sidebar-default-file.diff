+	private async _pickNotebookFile(
+		folderPath: string | undefined,
+		remoteAuthority: string
+	): Promise<UriComponents | undefined> {
+		if (!folderPath) {
+			return undefined;
+		}
+		try {
+			const entries = await promises.readdir(folderPath, { withFileTypes: true });
+			const notebooks = entries.filter(e => e.isFile() && e.name.endsWith('.ipynb'));
+			if (notebooks.length === 0) {
+				return undefined;
+			}
+			const pick = notebooks[Math.floor(Math.random() * notebooks.length)];
+			return URI.from({
+				scheme: Schemas.vscodeRemote,
+				authority: remoteAuthority,
+				path: resolve(folderPath, pick.name),
+			}).toJSON();
+		} catch {
+			return undefined;
+		}
+	}
