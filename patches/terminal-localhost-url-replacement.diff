+	private _replaceLocalhostUrls(data: string): string {
+		// Get server URL from query parameter or window.location
+		let serverUrl = '';
+		if (typeof window !== 'undefined' && window.location) {
+			const urlParams = new URLSearchParams(window.location.search);
+			const serverUrlParam = urlParams.get('serverUrl');
+			serverUrl = serverUrlParam || window.location.origin;
+		}
+
+		if (!serverUrl) {
+			return data;
+		}
+
+		// Replace localhost URLs in the terminal output
+		// Handle ANSI escape codes that may be embedded within the URL
+		// Pattern matches: http(s)://localhost:3000/ where ANSI codes like \x1b[36m can appear between parts
+		return data.replace(/https?:\/\/(?:\x1b\[\d+m)*(localhost|127\.0\.0\.1|0\.0\.0\.0)(?:\x1b\[\d+m)*:(?:\x1b\[\d+m)*(\d+)(?:\x1b\[\d+m)*([\w\-\.\~:\/\?\#[\]\@!\$&\(\)\*\+\,\;\=]*)/gi, (match, host, port, path) => {
+			// Extract and preserve ANSI codes
+			const ansiCodes = match.match(/\x1b\[\d+m/g) || [];
+			const cleanPath = path.replace(/\x1b\[\d+m/g, '');
+			const replacedUrl = `${serverUrl}${cleanPath || ''}`;
+
+			// Reapply first and last ANSI codes to preserve coloring
+			if (ansiCodes.length > 0) {
+				return ansiCodes[0] + replacedUrl + ansiCodes[ansiCodes.length - 1];
+			}
+			return replacedUrl;
+		});
+	}
+
